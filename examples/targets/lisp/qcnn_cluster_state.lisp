(defun rotr32 (x n)
  (let ((x (logand x #xFFFFFFFF)))
    (logand #xFFFFFFFF (logior (ash x (- n)) (ash x (- 32 n))))))
(defun w2hex (n)
  (let ((s (format nil "~x" n)))
    (concatenate 'string (subseq "00000000" (min 8 (length s))) s)))
(defun sha256 (msg)
  ;; FIPS 180-4 portado — inteiro puro, zero biblioteca
  (let* ((bytes (map 'vector #'char-code msg))
         (len (length bytes))
         (z (mod (- 56 (+ len 1)) 64))
         (total (+ len 1 z 8))
         (buf (make-array total :initial-element 0)))
    (loop for i below len do (setf (aref buf i) (aref bytes i)))
    (setf (aref buf len) #x80)
    (let ((bits (* len 8)))
      (loop for k from 0 to 7
            do (setf (aref buf (+ len 1 z k))
                     (logand 255 (ash bits (* -8 (- 7 k)))))))
    (let ((h0 #x6a09e667) (h1 #xbb67ae85) (h2 #x3c6ef372) (h3 #xa54ff53a)
          (h4 #x510e527f) (h5 #x9b05688c) (h6 #x1f83d9ab) (h7 #x5be0cd19))
      (loop for off from 0 below total by 64
            do (let ((w (make-array 64)))
                 (loop for i below 16
                       do (setf (aref w i)
                                (logior (ash (aref buf (+ off (* 4 i))) 24)
                                        (ash (aref buf (+ off (* 4 i) 1)) 16)
                                        (ash (aref buf (+ off (* 4 i) 2)) 8)
                                        (aref buf (+ off (* 4 i) 3)))))
                 (loop for i from 16 below 64
                       do (let* ((x15 (aref w (- i 15))) (x2 (aref w (- i 2)))
                                 (s0 (logxor (rotr32 x15 7) (rotr32 x15 18)
                                             (ash x15 -3)))
                                 (s1 (logxor (rotr32 x2 17) (rotr32 x2 19)
                                             (ash x2 -10))))
                            (setf (aref w i)
                                  (logand #xFFFFFFFF
                                          (+ (aref w (- i 16)) s0
                                             (aref w (- i 7)) s1)))))
                 (let ((a h0) (b h1) (cc h2) (d h3) (e h4) (f h5)
                       (g h6) (h h7))
                   (loop for i below 64
                         do (let* ((s1 (logxor (rotr32 e 6)
                                               (rotr32 e 11) (rotr32 e 25)))
                                   (ch (logior (logand e f)
                                               (logand (lognot e) g)))
                                   (t1 (+ h s1 ch (aref +k+ i) (aref w i)))
                                   (s0 (logxor (rotr32 a 2)
                                               (rotr32 a 13) (rotr32 a 22)))
                                   (maj (logior (logand a b)
                                                (logior (logand a cc)
                                                        (logand b cc))))
                                   (t2 (+ s0 maj)))
                              (setf h g g f f e)
                              (setf e (logand #xFFFFFFFF (+ d t1)))
                              (setf d cc cc b b a)
                              (setf a (logand #xFFFFFFFF (+ t1 t2)))))
                   (setf h0 (logand #xFFFFFFFF (+ h0 a)))
                   (setf h1 (logand #xFFFFFFFF (+ h1 b)))
                   (setf h2 (logand #xFFFFFFFF (+ h2 cc)))
                   (setf h3 (logand #xFFFFFFFF (+ h3 d)))
                   (setf h4 (logand #xFFFFFFFF (+ h4 e)))
                   (setf h5 (logand #xFFFFFFFF (+ h5 f)))
                   (setf h6 (logand #xFFFFFFFF (+ h6 g)))
                   (setf h7 (logand #xFFFFFFFF (+ h7 h))))))
      (concatenate 'string
                   (w2hex h0) (w2hex h1) (w2hex h2) (w2hex h3)
                   (w2hex h4) (w2hex h5) (w2hex h6) (w2hex h7)))))
