{
  "name": "Zephirum",
  "scopeName": "source.zephirum",
  "fileTypes": ["zeph"],
  "patterns": [
    {
      "name": "comment.line.number-sign.zephirum",
      "begin": "#",
      "end": "$",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.zephirum" } }
    },
    {
      "match": "^\\s*(ASK|CONTRACT|MODEL|BUDGET|REQUIRE)\\s*:",
      "captures": { "1": { "name": "keyword.control.block.zephirum" } }
    },
    {
      "match": "^[ \\t]*([A-Za-z_][A-Za-z0-9_]*)([ \\t]*):",
      "captures": {
        "1": { "name": "entity.name.tag.key.zephirum" },
        "2": { "name": "punctuation.separator.key-value.zephirum" }
      }
    },
    {
      "match": "^[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*$",
      "captures": { "1": { "name": "constant.language.flag.zephirum" } }
    },
    {
      "match": "\\b(sum|mean|median)\\b",
      "name": "variable.language.target.zephirum"
    },
    {
      "match": "\\bnone\\b",
      "name": "constant.language.none.zephirum"
    },
    {
      "match": "(==|>=|<=|>|<)",
      "name": "keyword.operator.comparison.zephirum"
    },
    {
      "match": "(\\*\\*|//|[+\\-*/%])",
      "name": "keyword.operator.arithmetic.zephirum"
    },
    {
      "match": "\\.\\.",
      "name": "punctuation.separator.range.zephirum"
    },
    {
      "match": "-?[0-9]+(\\.[0-9]+)?",
      "name": "constant.numeric.zephirum"
    },
    {
      "match": ",",
      "name": "punctuation.separator.comma.zephirum"
    }
  ]
}
