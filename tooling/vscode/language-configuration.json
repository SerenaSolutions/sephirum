{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(ASK|CONTRACT|MODEL|BUDGET|REQUIRE)\\s*:.*$",
    "decreaseIndentPattern": "^\\s*(ASK|CONTRACT|MODEL|BUDGET|REQUIRE)\\s*:"
  }
}
