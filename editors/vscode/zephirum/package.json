{
  "name": "zephirum",
  "displayName": "Zephirum",
  "description": "Language support for Zephirum (.zeph): ask a question about a computation, prove the answer without executing when possible. Necessity-first computing.",
  "version": "0.1.0",
  "publisher": "SerenaSolutions",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "repository": { "type": "git", "url": "https://github.com/SerenaSolutions/sephirum" },
  "contributes": {
    "languages": [
      {
        "id": "zephirum",
        "aliases": ["Zephirum"],
        "extensions": [".zeph"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zephirum",
        "scopeName": "source.zephirum",
        "path": "./syntaxes/zephirum.tmLanguage.json"
      }
    ]
  }
}
